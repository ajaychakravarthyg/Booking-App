# ─────────────────────────────────────────────────────────────────────────────────
# Copy to .env for docker-compose:   cp .env.example .env
#
# .env is gitignored. Every value below has a working default, so `docker compose up`
# succeeds without this file — but the defaults are DEVELOPMENT ONLY.
# ─────────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────────
POSTGRES_DB=hotel_booking
POSTGRES_USER=hotel
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433

# ── JWT signing secret ───────────────────────────────────────────────────────────
# THE one value you must change before any deployment.
#
# auth-service signs tokens with it; the gateway, room-service and booking-service
# verify against it. All four must receive the IDENTICAL string or every authenticated
# request returns 401.
#
# Minimum 32 characters (256 bits) for HS256 — the services refuse to start otherwise,
# which is deliberate: a short secret is a guessable one.
#
# Generate a strong one:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-before-deploying-0123456789

# How long an access token stays valid, in seconds. 86400 = 24h.
JWT_EXPIRATION_SECONDS=86400

# ── Seeded administrator ─────────────────────────────────────────────────────────
# Created by auth-service on an empty database only, then never touched again.
# Change the password before exposing the deployment publicly.
ADMIN_EMAIL=admin@hotel.com
ADMIN_NAME=Hotel Administrator
ADMIN_PASSWORD=Admin@12345

# Set to false to skip seeding the admin account and the sample room catalog.
SEED_ENABLED=true

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the gateway, comma separated. Wildcards are permitted
# because these are matched as patterns, which is what makes Vercel preview URLs work:
#   https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174,http://localhost:4173

# Public URL of the gateway, used as the default server in the Swagger UI.
PUBLIC_API_URL=http://localhost:9080

# ── Ports on the host ────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
GATEWAY_PORT=9080
AUTH_PORT=9081
ROOM_PORT=9082
BOOKING_PORT=9083
EUREKA_PORT=9761

# ── Booking rules ────────────────────────────────────────────────────────────────
BOOKING_MAX_NIGHTS=30
BOOKING_MAX_DAYS_AHEAD=365

# ── Schema management ────────────────────────────────────────────────────────────
# `update` lets Hibernate create and evolve tables, which suits a demo. Switch to
# `validate` and adopt Flyway for anything real — see README > Database migrations.
DDL_AUTO=update

# Connection pool size PER SERVICE. Three services share one instance, so on a free
# managed Postgres (often ~20-100 total connections) keep this small.
DB_POOL_MAX=5

LOG_LEVEL=INFO
