# ─────────────────────────────────────────────────────────────────────────────────
# Frontend configuration — copy to .env.local and adjust.
#
# Only VITE_-prefixed variables reach the browser, and everything here IS public:
# Vite inlines these values into the JavaScript bundle at build time. Never put a
# secret, API key or database credential in this file.
# ─────────────────────────────────────────────────────────────────────────────────

# Base URL of the API gateway.
#
# LOCAL DEV: leave this blank/unset. Requests then go to /api on the Vite dev server,
# which proxies to the gateway (see vite.config.js). Same-origin, so CORS never applies.
#
# PRODUCTION (Vercel): set this to your deployed gateway, e.g.
#   VITE_API_BASE_URL=https://hotel-api-gateway.onrender.com
VITE_API_BASE_URL=

# Where the dev-server proxy forwards /api. Only used by `npm run dev`.
VITE_DEV_PROXY_TARGET=http://localhost:8080
